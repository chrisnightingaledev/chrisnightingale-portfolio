---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { profile, services, principles } from '../data/site';
---
<Layout>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-intro"><span class="eyebrow"><span class="small-rule" aria-hidden="true"></span>{profile.role}</span></div>
    <div class="hero-grid">
      <h1 id="hero-title">Make existing<br />software<br /><em>work better.</em></h1>
      <div class="hero-copy">
        <p>I help organisations maintain, improve and modernise the .NET applications they already depend on.</p>
        <p class="secondary-copy">From understanding a difficult legacy system to planning its next chapter.</p>
        <a class="button" href={`mailto:${profile.email}`}>Talk about your application <Arrow diagonal /></a>
        <a class="text-link" href="#expertise">Explore how I can help <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <div class="technology-line"><span class="eyebrow">Built on experience with</span><ul aria-label="Core technologies"><li>C#</li><li>.NET / ASP.NET Core</li><li>SQL Server</li><li>Microsoft Azure</li></ul></div>
  </section>

  <section class="expertise wrap section" id="expertise" aria-labelledby="expertise-title">
    <div class="section-heading"><p class="eyebrow">01 / What I do</p><div><h2 id="expertise-title">A way forward for<br />the software you have.</h2><p class="section-intro">Support for the everyday work, the difficult problems<br class="desktop-break" /> and the changes you’ve been putting off.</p></div></div>
    <div class="service-list">
      {services.map((service, i) => <article class="service"><span class="service-number" aria-hidden="true">0{i + 1}</span><div class="service-title"><p class="eyebrow">{service.category}</p><h3>{service.title}</h3></div><p>{service.description}</p></article>)}
    </div>
  </section>

  <section class="approach" id="approach" aria-labelledby="approach-title">
    <div class="wrap section">
      <div class="section-heading"><p class="eyebrow">02 / How I work</p><h2 id="approach-title">Good engineering starts<br />with <em>understanding.</em></h2></div>
      <div class="principles">{principles.map((principle, i) => <article><span class="principle-marker" aria-hidden="true">0{i + 1}<span></span></span><h3>{principle.title}</h3><p>{principle.description}</p></article>)}</div>
      <p class="approach-note"><span aria-hidden="true">↳</span> A practical approach, shaped around your system and your business.</p>
    </div>
  </section>

  <section class="about wrap section" id="about" aria-labelledby="about-title">
    <div class="about-heading"><p class="eyebrow">03 / About me</p><h2 id="about-title">An engineer who<br />gets into<br /><em>the details.</em></h2><span class="about-signature" aria-hidden="true">Chris Nightingale<span>Freelance Senior .NET Developer</span></span></div>
    <div class="about-copy"><p class="lead">I’m Chris, a Senior .NET Developer with a background in established business applications and the older technologies that often underpin them.</p><p>I’m comfortable getting to know an unfamiliar system: understanding its behaviour, working through its complexities and finding practical ways to improve it.</p><p>As an independent engineer, I bring that same approach to freelance and contract work — helping teams meet immediate needs while making their applications easier to maintain and develop over time.</p><div class="experience"><p class="eyebrow">Professional experience includes</p><ul><li>NHS Property Services</li><li>Law Business Research</li></ul></div></div>
  </section>

  <section class="contact wrap" id="contact" aria-labelledby="contact-title">
    <div class="contact-panel"><div><p class="eyebrow">04 / Get in touch</p><h2 id="contact-title">Let’s talk about<br /><em>your application.</em></h2><p>Maintaining a legacy system, planning a migration or working through a difficult production issue? I’d be happy to hear what you’re facing.</p></div><div class="contact-actions"><p>For freelance, contract and<br />modernisation opportunities.</p><a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}<Arrow diagonal /></a><div class="social-links"><a href={profile.linkedin}>LinkedIn <Arrow diagonal /></a><a href={profile.github}>GitHub <Arrow diagonal /></a></div></div></div>
  </section>
</Layout>
